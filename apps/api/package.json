    "brief": "tsx src/brief.ts",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^10.1.11",
    "dotenv": "^17.0.0",
    "fastify": "^5.2.0",
    "jose": "^6.2.18",
    "node-cron": "^4.0.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}