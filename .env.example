DATABASE_URL=postgres://localhost:5432/secondbrain
API_PORT=4010
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# production: тот же процесс отдаёт собранный фронт
SERVE_WEB=0

# обязателен в production: подпись access-токенов (32+ случайных байта)
JWT_SECRET=

# secure-кука; в production включается автоматически
COOKIE_SECURE=0

# необязательно: включает LLM-ресерч агента
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# демо-данные: если не заданы, seed сгенерирует пароль и напечатает его
SEED_EMAIL=demo@secondbrain.local
SEED_PASSWORD=
